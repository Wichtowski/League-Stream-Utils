{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./app/*"],
      "next": ["./node_modules/vinext/dist/shims/metadata.d.ts"],
      "next/server": ["./node_modules/vinext/dist/shims/server.d.ts"],
      "next/navigation": ["./node_modules/vinext/dist/shims/navigation.d.ts"],
      "next/headers": ["./node_modules/vinext/dist/shims/headers.d.ts"],
      "next/link": ["./node_modules/vinext/dist/shims/link.d.ts"],
      "@lsu/db": ["../../packages/db/src"],
      "@lsu/db/*": ["../../packages/db/src/*"],
      "@lsu/db-mongo": ["../../packages/db-mongo/src"],
      "@lsu/types": ["../../packages/types/src"],
      "@lsu/ui": ["../../packages/ui/src"],
      "@lsu/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["app", "vite.config.ts", "next.config.ts"],
  "exclude": ["node_modules", "dist"]
}

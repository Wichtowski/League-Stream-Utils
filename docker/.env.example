# PostgreSQL
POSTGRES_USER=lsu
POSTGRES_PASSWORD=lsu_dev_password
POSTGRES_DB=league_stream_utils
POSTGRES_PORT=5432

# MongoDB
MONGO_USER=lsu
MONGO_PASSWORD=lsu_dev_password
MONGO_DB=league_stream_utils
MONGO_PORT=27017

# pgAdmin (optional — start with: docker compose --profile tools up -d)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@lsu.dev
PGADMIN_PASSWORD=admin

# Connection strings (used by app)
DATABASE_URL=postgresql://lsu:lsu_dev_password@localhost:5432/league_stream_utils
MONGODB_URI=mongodb://lsu:lsu_dev_password@localhost:27017/league_stream_utils?authSource=admin
